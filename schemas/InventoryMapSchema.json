{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory Map Schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "item_id": { "type": "string" },
      "quantity": { "type": "integer", "minimum": 1 },
      "position": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      },
      "schema_version": { "type": "string" }
    },
    "required": ["item_id", "quantity", "position"],
    "additionalProperties": false
  }
}
