{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InventoryMapSchema",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9\\-]+$": {
      "type": "object",
      "required": ["item_id", "quantity", "schema_version"],
      "properties": {
        "item_id": { "type": "string" },
        "quantity": { "type": "number" },
        "zone_id": { "type": ["string", "null"] },
        "schema_version": { "type": "string" },
        "tile": {
          "type": "object",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "position": {
          "type": "object",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "z_layer": { "type": "number" }
      },
      "oneOf": [ { "required": ["tile"] }, { "required": ["position"] } ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
