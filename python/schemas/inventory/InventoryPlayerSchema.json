{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory Player Schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "player_id": { "type": "string", "format": "uuid" },
        "capacity": { "type": "integer", "minimum": 0 },
        "slots": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "item": { "type": "string" },
                  "quantity": { "type": "integer", "minimum": 0 },
                  "stack_id": { "type": "string", "format": "uuid" }
                },
                "required": ["item", "quantity"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          }
        },
        "schema_version": { "type": "string" }
      },
      "required": ["player_id", "capacity", "slots"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "player_id": { "type": "string", "format": "uuid" },
              "capacity": { "type": "integer", "minimum": 0 },
              "slots": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "item": { "type": "string" },
                        "quantity": { "type": "integer", "minimum": 0 },
                        "stack_id": { "type": "string", "format": "uuid" }
                      },
                      "required": ["item", "quantity"],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                }
              }
            },
            "required": ["capacity", "slots"],
            "additionalProperties": false
          }
        },
        "schema_version": { "type": "string" }
      },
      "required": ["classes"],
      "additionalProperties": false
    }
  ]
}
