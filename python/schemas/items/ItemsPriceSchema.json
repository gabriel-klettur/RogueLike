{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemsPrice",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-zA-Z0-9_\\-]+$": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "properties": {
            "buy": { "type": "number" },
            "sell": { "type": "number" },
            "price": { "type": "number" }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    }
  }
}