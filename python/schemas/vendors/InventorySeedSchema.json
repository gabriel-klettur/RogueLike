{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventorySeed",
  "type": "object",
  "properties": {
    "template_id": { "type": ["string", "null"] },
    "schema_version": { "type": ["string", "null"] },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 }
        },
        "required": ["item", "quantity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["slots"],
  "additionalProperties": false
}