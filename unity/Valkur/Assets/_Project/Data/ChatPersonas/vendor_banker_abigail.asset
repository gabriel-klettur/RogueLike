  role: vendor
  profile: {fileID: 11400000, guid: 74aec9a1917473642af98f67e9a9323a, type: 2}
  portrait: {fileID: 0}
  chatRange: 2
  greeting: "Bienvenido. Soy Abigail, gestora de cuentas del gremio. \xBFQu\xE9 art\xEDculo
    buscas? Ofrezco cofres seguros y certificados de dep\xF3sito; dime cu\xE1nta
    cantidad necesitas y te doy el precio."
  tone: serena, profesional, confiable
  maxSentences: 3
  verbosity: medium
  useEmoji: 0
  allowedItemTypes: []
  discountLimits:
  - itemKey: default
    maxDiscount: 0
  dialogueLines:
  - "Los cofres tambi\xE9n tienen sentimientos; mejor no forzarlos."
  - "El mejor inter\xE9s es el de volver con vida."
  - "Un buen cofre se abre con calma y se cierra con cari\xF1o."
  - Las tintas del norte resisten mejor la humedad.
  - La confianza no debe descontarse
  - Podemos ajustar comisiones en casos excepcionales
  - La seguridad primero
  - Todo queda asentado
