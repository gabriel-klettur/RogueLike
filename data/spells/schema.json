{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spells Config",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {
          "type": "string",
          "enum": [
            "projectile",
            "aura",
            "beam",
            "dash",
            "slash",
            "lightning",
            "arcane_flame",
            "firework_launch",
            "smoke",
            "smoke_emitter",
            "sphere_magic_shield",
            "teleport"
          ]
        },
        "prepare_duration": {"type": "number"},
        "channel_duration": {"type": "number"},
        "cooldown_duration": {"type": "number"},
        "lock_cast_direction": {"type": "boolean"},
        "max_instances": {"type": "integer", "minimum": 0},
        "allow_overlap": {"type": "boolean"},
        "allow_movement": {"type": "boolean"},
        "interruptible": {"type": "boolean"},
        "automatic": {"type": "boolean"},
        "automatic_cast_punish": {"type": "number"},

        "speed": {"type": "number"},
        "damage": {"type": "number"},
        "lifespan": {"type": "number"},
        "range": {"type": "number"},
        "sprite": {"type": ["string", "null"]},
        "scale": {"type": "number"},

        "radius": {"type": "number"},
        "duration": {"type": "number"},
        "buff": {"type": "object", "additionalProperties": {"type": ["number", "integer", "boolean", "string"]}},

        "particle_count": {"type": "integer"},
        "particle_dispersion": {"type": "number"},
        "particle_colors": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 255},
            "minItems": 3,
            "maxItems": 3
          }
        },
        "segments": {"type": "integer"},
        "offset": {"type": "number"},
        "lifetime": {"type": "number"},

        "distance": {"type": "number"},

        "size_range": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        },
        "color": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 255},
          "minItems": 3,
          "maxItems": 3
        },
        "speed_multiplier": {"type": "number"},
        "arc_range_degrees": {"type": "number"},

        "particle_color": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 255},
          "minItems": 3,
          "maxItems": 3
        },
        "emit_rate": {"type": "integer"},

        "vfx": {"type": ["string", "null"]},
        "particle_lifespan": {"type": "number"},
        "particle_speed": {"type": "number"}
      },
      "required": ["id", "name", "type"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
