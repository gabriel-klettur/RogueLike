{
  "version": 1,
  "sets": [
    {
      "id": "Player_Default",
      "label": "Player Default",
      "states": [
        { "id": "Idle", "class": "IdleState", "props": {} },
        { "id": "Move", "class": "MoveState", "props": {} },
        { "id": "Attack", "class": "PlayerAttackState", "props": {} },
        { "id": "SpellSelect", "class": "PlayerSpellSelectState", "props": {} }
      ],
      "transitions": [
        { "from": "Idle", "to": "Move", "when": "input.move" },
        { "from": "Move", "to": "Idle", "when": "input.stop" },
        { "from": "Idle", "to": "Attack", "when": "input.attack" },
        { "from": "Idle", "to": "SpellSelect", "when": "key.q_or_e_edge" },
        { "from": "SpellSelect", "to": "Idle", "when": "key.escape" }
      ],
      "initial": "Idle"
    },
    {
      "id": "Monster_Goblin",
      "label": "Goblin",
      "states": [
        { "id": "Patrol", "class": "PatrolState" },
        { "id": "Chase", "class": "ChaseState" },
        { "id": "Attack", "class": "AttackState" }
      ],
      "transitions": [
        { "from": "Patrol", "to": "Chase", "when": "player_in_range" },
        { "from": "Chase", "to": "Attack", "when": "melee_range" },
        { "from": "Attack", "to": "Chase", "when": "target_alive" }
      ],
      "initial": "Patrol"
    },
    {
      "id": "Monster_stupid",
      "label": "Monster Stupid",
      "states": [
        { "id": "Patrol", "class": "PatrolState" },
        { "id": "Damage", "class": "DamageState" }
      ],
      "transitions": [
        { "from": "Damage", "to": "Patrol", "when": "after_damage" }
      ],
      "initial": "Patrol"
    },
    {
      "id": "Monster_Default",
      "label": "Monster Default",
      "states": [
        { "id": "Patrol", "class": "PatrolState" },
        { "id": "Aggro", "class": "AggroState" },
        { "id": "Chase", "class": "ChaseState" },
        { "id": "Attack", "class": "AttackState" },
        { "id": "Flee", "class": "FleeState" },
        { "id": "AlertChase", "class": "AlertChaseState" },
        { "id": "Damage", "class": "DamageState" },
        { "id": "Death", "class": "DeathState" }
      ],
      "transitions": [
        { "from": "Patrol", "to": "Aggro", "when": "player_in_aggro" },
        { "from": "Aggro", "to": "Chase", "when": "aggro_continue" },
        { "from": "Aggro", "to": "Attack", "when": "melee_range" },
        { "from": "Aggro", "to": "Flee", "when": "low_health" },
        { "from": "Chase", "to": "Attack", "when": "melee_range" },
        { "from": "Chase", "to": "Patrol", "when": "lost_player" },
        { "from": "Attack", "to": "Chase", "when": "out_of_melee_range" },
        { "from": "Damage", "to": "AlertChase", "when": "after_damage" },
        { "from": "AlertChase", "to": "Patrol", "when": "timer_5s" },
        { "from": "Patrol", "to": "Death", "when": "dead" },
        { "from": "Aggro", "to": "Death", "when": "dead" },
        { "from": "Chase", "to": "Death", "when": "dead" },
        { "from": "Attack", "to": "Death", "when": "dead" },
        { "from": "Flee", "to": "Death", "when": "dead" },
        { "from": "AlertChase", "to": "Death", "when": "dead" }
      ],
      "initial": "Patrol"
    }
  ]
}
