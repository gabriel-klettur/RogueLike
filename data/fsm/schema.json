{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FSM Sets Schema",
  "type": "object",
  "$defs": {
    "style": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "width": { "type": "number" },
        "head_len": { "type": "number" },
        "head_width": { "type": "number" }
      },
      "additionalProperties": true
    },
    "ActionCall": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": true }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "GuardAST": {
      "type": "object",
      "properties": {
        "op": { "type": "string", "enum": ["and", "or", "not", "cmp", "const", "get"] },
        "left": { "type": ["object", "number", "string", "boolean", "null" ] },
        "right": { "type": ["object", "number", "string", "boolean", "null" ] },
        "path": { "type": "string" },
        "cmp": { "type": "string", "enum": ["==","!=","<","<=",">",">="] },
        "value": {}
      },
      "required": ["op"],
      "additionalProperties": true
    },
    "BlackboardSpec": {
      "type": "object",
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "class": { "type": "string", "minLength": 1 },
        "special": { "type": "string" },
        "external_entry": { "type": "boolean" },
        "props": { "type": "object", "additionalProperties": true },
        "on_enter": { "type": "array", "items": { "$ref": "#/$defs/ActionCall" } },
        "on_exit": { "type": "array", "items": { "$ref": "#/$defs/ActionCall" } },
        "blackboard": { "$ref": "#/$defs/BlackboardSpec" },
        "initial": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer" },
        "h": { "type": "integer" }
      },
      "required": ["id", "class"],
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "actions": {
          "type": "array",
          "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/ActionCall" } ] }
        },
        "priority": { "type": "integer", "minimum": 0 },
        "cooldown_frames": { "type": "integer", "minimum": 0 },
        "guard": { "$ref": "#/$defs/GuardAST" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "style": { "$ref": "#/$defs/style" },
        "color": { "type": "string" },
        "width": { "type": "number" },
        "head_len": { "type": "number" },
        "head_width": { "type": "number" },
        "curved": { "type": "boolean" },
        "curve_step": { "type": "number" },
        "active": { "type": "boolean" },
        "global": { "type": "boolean" }
      },
      "required": ["from", "to"],
      "anyOf": [ { "required": ["when"] }, { "required": ["event"] } ],
      "additionalProperties": true
    }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "states": {
            "type": "array",
            "items": { "$ref": "#/$defs/state" }
          },
          "transitions": {
            "type": "array",
            "items": { "$ref": "#/$defs/transition" }
          },
          "initial": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "states", "transitions", "initial"],
        "additionalProperties": true
      }
    }
  },
  "required": ["version", "sets"],
  "additionalProperties": false
}
